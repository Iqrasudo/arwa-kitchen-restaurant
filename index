// Sound
function playSound(){
 try{
 var c=new(window.AudioContext||window.webkitAudioContext)();
 [523,659,784,1047].forEach(function(f,i){
 var o=c.createOscillator(),g=c.createGain();
 o.connect(g);g.connect(c.destination);
 o.frequency.value=f;o.type='sine';
 g.gain.setValueAtTime(0,c.currentTime+i*.18);
 g.gain.linearRampToValueAtTime(.4,c.currentTime+i*.18+.05);
 g.gain.linearRampToValueAtTime(0,c.currentTime+i*.18+.28);
 o.start(c.currentTime+i*.18);o.stop(c.currentTime+i*.18+.3);
 });
 }catch(e){}
}
