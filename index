 * Firebase is the single source of truth for the customer session.
 * We keep window.firebaseUser only as a UI mirror.
 * We NEVER call signOut() during checkout/order submission.
 */
onAuthStateChanged(auth, function(user){
 window.firebaseUser = user || null;
 updateAccountUI(user);

 if(user && window.pendingCheckout){
 window.pendingCheckout = false;

 setTimeout(function(){
 if(auth.currentUser && window.goCheckout){
 window.goCheckout();
 }
 }, 100);
 }
});



