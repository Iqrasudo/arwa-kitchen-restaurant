// Customer authentication UI
window.pendingCheckout = false;
var currentAuthMode='login';

window.openAuth=function(mode){
 currentAuthMode=(mode==='signup'?'signup':'login');
 document.getElementById('authModal').classList.add('open');
 renderAuthMode();
};

window.closeAuth=function(){
 document.getElementById('authModal').classList.remove('open');
 document.getElementById('authMsg').textContent='';
};

window.switchAuth=function(mode){
 currentAuthMode=(mode==='signup'?'signup':'login');
 renderAuthMode();
};
window.customerLogout = async function(){
 try{

 // This is the ONLY place where customer logout happens.
 await signOut(auth);

 // onAuthStateChanged will update window.firebaseUser and UI.
 window.pendingCheckout = false;

 var menu=document.getElementById('accountMenu');
 if(menu) menu.classList.remove('open');

 showToast(' You have been logged out.');

 }catch(err){

 console.error('Logout failed:',err);
 showToast('Logout failed.');

 }
};



function renderAuthMode(){
 var signup=currentAuthMode==='signup';
 document.getElementById('authTitle').textContent=signup?' Create Account':' Customer Login';
 document.getElementById('loginTab').classList.toggle('active',!signup);
 document.getElementById('signupTab').classList.toggle('active',signup);
 document.getElementById('signupNameWrap').style.display=signup?'block':'none';
 document.getElementById('authConfirmWrap').style.display=signup?'block':'none';
 document.getElementById('authSubmit').textContent=signup?'Create Account →':'Login →';
 document.getElementById('authSwitchText').innerHTML=signup
 ? 'Already have an account? <button onclick="switchAuth(\'login\')">Login</button>'
 : 'Don\'t have an account? <button onclick="switchAuth(\'signup\')">Create one</button>';
 document.getElementById('authMsg').textContent='';
}

window.submitAuth=async function(){

 var email=document.getElementById('authEmail').value.trim();
 var pass=document.getElementById('authPassword').value;
 var msg=document.getElementById('authMsg');
 var btn=document.getElementById('authSubmit');

 if(!email || !pass){
 msg.textContent='Please enter email and password.';
 return;
 }

 if(pass.length<6){
 msg.textContent='Password must be at least 6 characters.';
 return;
 }

 var name='';
 var confirm='';

 if(currentAuthMode==='signup'){

 name=document.getElementById('authName').value.trim();
 confirm=document.getElementById('authConfirm').value;

 if(!name){
 msg.textContent='Please enter your name.';
 return;
 }

 if(pass!==confirm){
 msg.textContent='Passwords do not match.';
 return;
 }
 }

 btn.disabled=true;
 btn.textContent='⏳ Please wait...';
 msg.textContent='';

 try{

 if(currentAuthMode==='signup'){

 await window.customerSignup(name,email,pass);

 msg.style.color='#5b21b6';
 msg.textContent=' Account created successfully.';

 }else{

 await window.customerLogin(email,pass);

 msg.style.color='#5b21b6';
 msg.textContent=' Login successful.';
 }

 /*
 * Do NOT manually set firebaseUser here.
 * Firebase onAuthStateChanged handles it.
 *
 * Do NOT logout here.
 */
 setTimeout(function(){
 window.closeAuth();
 },350);

 }catch(err){

 msg.style.color='#c0392b';

 var code=err && err.code ? err.code : '';

 var friendly={
 'auth/email-already-in-use':'This email is already registered.',
 'auth/invalid-email':'Please enter a valid email address.',
 'auth/weak-password':'Password is too weak. Use at least 6 characters.',
 'auth/invalid-credential':'Incorrect email or password.',
 'auth/user-not-found':'No account found with this email.',
 'auth/wrong-password':'Incorrect email or password.'
 };

 msg.textContent=friendly[code] || (err.message || 'Authentication failed.');

 }finally{

 btn.disabled=false;
 btn.textContent=currentAuthMode==='signup'
 ? 'Create Account →'
 : 'Login →';
 }
};



document.getElementById('cartModal').addEventListener('click',function(e){if(e.target===this)closeCart();});
document.getElementById('coModal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});
document.getElementById('authModal').addEventListener('click',function(e){if(e.target===this)closeAuth();});
renderAuthMode();
