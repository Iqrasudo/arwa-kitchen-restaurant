<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Arwa Kitchen — Homemade • Healthy • Delicious</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
 --purple-ink:#150a29;
 --purple-deep:#2b0f5c;
 --purple:#5b21b6;
 --purple-light:#9d6dff;
 --gold-deep:#a9790b;
 --gold:#d6a337;
 --gold-light:#f2c863;
 --white:#ffffff;
 --paper:#faf7ff;
 --ink:#160c28;
 --red:#e0554a;
 /* legacy aliases so the rest of the stylesheet re-themes automatically */
 --green:var(--purple-deep);
 --green-mid:var(--purple);
 --green-light:var(--purple-light);
 --cream:var(--paper);
 --dark:var(--ink);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Manrope',sans-serif;background:var(--paper);color:var(--ink);overflow-x:hidden;line-height:1.6;}
h1,h2,h3,.nav-logo,.day-num{font-family:'Fraunces',serif;}
a{text-decoration:none;}
.fade-up{opacity:0;transform:translateY(30px);transition:opacity .6s ease,transform .6s ease;}
.fade-left{opacity:0;transform:translateX(-30px);transition:opacity .6s ease,transform .6s ease;}
.zoom-in{opacity:0;transform:scale(.92);transition:opacity .6s ease,transform .6s ease;}
.visible{opacity:1!important;transform:none!important;}
.fade-up,.fade-left,.zoom-in{opacity:1;transform:none;}

/* ---- shared icon + motion utilities ---- */
.ic{display:inline-block;vertical-align:-3px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
@keyframes kenburns{0%{transform:scale(1.08) translate(0,0);}100%{transform:scale(1.22) translate(-1.5%,-1%);}}
@keyframes shimmerText{0%{background-position:0% 50%}100%{background-position:200% 50%}}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes floatSlow{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-14px) rotate(3deg)}}
.grad-text{background:linear-gradient(90deg,var(--gold-light),var(--white) 40%,var(--gold) 60%,var(--gold-light));background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmerText 6s linear infinite;}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important;}
}


nav{position:fixed;top:0;width:100%;z-index:9999;background:rgba(21,10,41,0.97);backdrop-filter:blur(12px);padding:0 40px;height:65px;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid var(--gold);}
.nav-logo{font-family:'Fraunces',serif;font-size:1.55rem;font-weight:900;color:var(--gold);}
.nav-logo span{color:var(--green-light);}
.nav-links{display:flex;gap:18px;list-style:none;}
.nav-links a{color:rgba(255,255,255,.85);font-weight:600;font-size:.8rem;transition:color .25s,transform .25s;position:relative;padding:4px 0;display:inline-block;}
.nav-links a:hover{color:var(--gold-light);transform:translateY(-2px);}
.nav-links a::after{content:'';position:absolute;bottom:-2px;left:0;width:0;height:2px;background:var(--gold);transition:width .3s;}
.nav-links a:hover,.nav-links a.act{color:var(--gold);}
.nav-links a:hover::after,.nav-links a.act::after{width:100%;}
.nav-cta{background:linear-gradient(135deg,var(--gold),var(--gold-light));color:var(--dark);padding:9px 18px;border-radius:30px;font-weight:800;font-size:.82rem;white-space:nowrap;display:inline-block;transition:transform .3s cubic-bezier(.34,1.56,.64,1),box-shadow .3s;}
.nav-cta:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 10px 26px rgba(214,163,55,.4);}
.account-btn{background:rgba(255,255,255,.10);color:white;border:1px solid rgba(255,255,255,.25);padding:8px 15px;border-radius:22px;font-family:'Manrope',sans-serif;font-weight:800;font-size:.8rem;cursor:pointer;white-space:nowrap;transition:.2s;}.account-btn:hover{background:rgba(255,255,255,.18);border-color:var(--gold);color:var(--gold);}.auth-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:1000000;align-items:center;justify-content:center;padding:20px;}.auth-modal.open{display:flex;}.auth-box{background:white;border-radius:24px;width:100%;max-width:430px;overflow:hidden;box-shadow:0 20px 70px rgba(0,0,0,.35);}.auth-head{background:linear-gradient(135deg,var(--green),var(--green-mid));color:white;padding:24px 28px;}.auth-head h3{font-family:'Fraunces',serif;font-size:1.5rem;}.auth-body{padding:26px 28px;}.auth-tabs{display:flex;gap:8px;background:#f2f7f3;border-radius:12px;padding:4px;margin-bottom:18px;}.auth-tab{flex:1;border:0;background:transparent;padding:10px;border-radius:9px;font-family:'Manrope',sans-serif;font-weight:800;cursor:pointer;color:#666;}.auth-tab.active{background:white;color:var(--green);box-shadow:0 2px 8px rgba(0,0,0,.08);}.auth-field{margin-bottom:14px;}.auth-field label{display:block;font-size:.8rem;font-weight:800;color:#444;margin-bottom:6px;}.auth-field input{width:100%;padding:12px 14px;border:2px solid #e8e8e8;border-radius:12px;font-family:'Manrope',sans-serif;outline:none;}.auth-field input:focus{border-color:var(--green-light);}.auth-submit{width:100%;padding:14px;border:0;border-radius:12px;background:linear-gradient(135deg,var(--green),var(--green-mid));color:white;font-family:'Manrope',sans-serif;font-weight:800;cursor:pointer;}.auth-close{float:right;background:rgba(255,255,255,.16);border:0;color:white;width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:1rem;}.auth-msg{margin-bottom:12px;font-size:.82rem;min-height:18px;color:#c0392b;font-weight:700;}.auth-switch{margin-top:14px;text-align:center;font-size:.82rem;color:#777;}.auth-switch button{border:0;background:none;color:var(--green);font-weight:800;cursor:pointer;}
.hamburger{display:none;cursor:pointer;flex-direction:column;gap:5px;}
.hamburger span{display:block;width:24px;height:2px;background:white;border-radius:2px;}
.mobile-menu{display:none;flex-direction:column;position:fixed;top:65px;left:0;width:100%;background:rgba(21,10,41,.98);z-index:9998;}
.mobile-menu.open{display:flex;}
.mobile-menu a{color:rgba(255,255,255,.85);padding:13px 28px;font-weight:600;border-bottom:1px solid rgba(255,255,255,.06);}

.hero{min-height:100vh;background:linear-gradient(160deg,#0d0420 0%,#2b0f5c 45%,#1c0a3d 100%);display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:100px 24px 70px;position:relative;overflow:hidden;}
.hero-slideshow{position:absolute;inset:0;z-index:0;}
.hs-slide{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;filter:saturate(1.2) contrast(1.05);animation:heroFade 20s infinite;}
.hs-slide:nth-child(1){animation-delay:0s;}
.hs-slide:nth-child(2){animation-delay:5s;}
.hs-slide:nth-child(3){animation-delay:10s;}
.hs-slide:nth-child(4){animation-delay:15s;}
@keyframes heroFade{0%{opacity:0;transform:scale(1.05)}5%{opacity:.42}20%{opacity:.42;transform:scale(1.16)}25%{opacity:0}100%{opacity:0}}
.hero-scrim{position:absolute;inset:0;z-index:1;background:linear-gradient(160deg,rgba(13,4,32,.86) 0%,rgba(43,15,92,.8) 45%,rgba(28,10,61,.9) 100%);}
.hero-float{position:absolute;z-index:1;border-radius:50%;filter:blur(1px);opacity:.5;animation:floatSlow 8s ease-in-out infinite;pointer-events:none;background-size:cover;background-position:center;border:2px solid rgba(214,163,55,.4);box-shadow:0 10px 40px rgba(0,0,0,.4);}
.hero-float.f1{width:90px;height:90px;top:16%;left:8%;animation-duration:9s;background-image:url('https://images.unsplash.com/photo-1512058564366-18510be2db19?q=80&w=300&auto=format&fit=crop');}
.hero-float.f2{width:70px;height:70px;top:64%;left:11%;animation-duration:7s;animation-delay:1s;background-image:url('https://images.unsplash.com/photo-1585032226651-759b368d7246?q=80&w=300&auto=format&fit=crop');}
.hero-float.f3{width:80px;height:80px;top:22%;right:9%;animation-duration:10s;animation-delay:.5s;background-image:url('https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=300&auto=format&fit=crop');}
.hero-float.f4{width:64px;height:64px;top:66%;right:12%;animation-duration:8s;animation-delay:1.5s;background-image:url('https://images.unsplash.com/photo-1600628421066-f6bda6a7b976?q=80&w=300&auto=format&fit=crop');}
@media (max-width:640px){.hero-float{display:none;}}
.hero::before{content:'';position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(157,109,255,.18) 0%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);animation:glow 6s ease-in-out infinite alternate;}
@keyframes glow{from{transform:translate(-50%,-50%) scale(1)}to{transform:translate(-50%,-50%) scale(1.3)}}
.particle{position:absolute;border-radius:50%;background:rgba(201,168,76,.15);animation:floatP linear infinite;pointer-events:none;}
@keyframes floatP{from{transform:translateY(100vh) rotate(0deg);opacity:0}10%{opacity:1}90%{opacity:1}to{transform:translateY(-100px) rotate(720deg);opacity:0}}
.hero-ribbon{position:relative;z-index:2;background:var(--red);color:white;padding:8px 26px;border-radius:30px;font-weight:800;font-size:.8rem;letter-spacing:2px;text-transform:uppercase;margin-bottom:22px;animation:popIn .7s .3s both;}
@keyframes popIn{from{transform:scale(0) rotate(-10deg);opacity:0}to{transform:scale(1) rotate(0);opacity:1}}
.hero h1{font-family:'Fraunces',serif;font-size:clamp(3rem,9vw,7.5rem);font-weight:900;line-height:.95;position:relative;z-index:2;animation:fadeUp .9s .5s both;}
.hero h1 .tg{color:var(--gold-light);display:block;}
.hero h1 .tv{display:block;}
.hero h1 .tv{background:linear-gradient(90deg,var(--gold-light),var(--white) 40%,var(--gold) 60%,var(--gold-light));background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmerText 6s linear infinite;}
@keyframes fadeUp{from{transform:translateY(35px);opacity:0}to{transform:translateY(0);opacity:1}}
.hero-tagline{position:relative;z-index:2;color:rgba(255,255,255,.7);font-size:clamp(.95rem,2vw,1.15rem);margin:18px 0 0;font-weight:400;animation:fadeUp .9s .65s both;}
.hero-pills{position:relative;z-index:2;display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin:24px 0 32px;animation:fadeUp .9s .8s both;}
.pill{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.9);padding:7px 17px;border-radius:20px;font-size:.83rem;font-weight:600;}
.hero-btns{position:relative;z-index:2;display:flex;gap:14px;flex-wrap:wrap;justify-content:center;animation:fadeUp .9s .95s both;}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold-light));color:var(--dark);padding:14px 36px;border-radius:50px;font-weight:800;font-size:.97rem;transition:transform .25s,box-shadow .25s;display:inline-flex;align-items:center;gap:8px;}
.btn-gold:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(201,168,76,.5);}
.btn-outline{background:transparent;color:white;padding:14px 36px;border-radius:50px;font-weight:700;font-size:.97rem;border:2px solid rgba(255,255,255,.35);transition:background .25s;display:inline-flex;align-items:center;gap:8px;}
.btn-outline:hover{background:rgba(255,255,255,.1);}
.price-box{position:relative;z-index:2;margin-top:36px;background:rgba(43,15,92,.55);border:2px solid var(--gold);border-radius:20px;padding:18px 36px;color:white;line-height:1.7;backdrop-filter:blur(8px);animation:fadeUp .9s 1.1s both;}
.price-box .big{color:var(--gold);font-size:2rem;font-weight:900;font-family:'Fraunces',serif;}
.scroll-hint{position:relative;z-index:2;margin-top:46px;color:rgba(255,255,255,.28);font-size:.76rem;letter-spacing:2px;text-transform:uppercase;animation:bounce 2.5s infinite;}
@keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}

.food-strip{width:100%;overflow:hidden;background:var(--purple-ink);padding:14px 0;border-top:2px solid var(--gold);border-bottom:2px solid var(--gold);}
.food-strip-track{display:flex;gap:14px;width:max-content;animation:marquee 34s linear infinite;}
.food-strip.rev .food-strip-track{animation-direction:reverse;animation-duration:40s;}
.fs-item{width:120px;height:120px;border-radius:16px;background-size:cover;background-position:center;flex-shrink:0;filter:grayscale(.55) brightness(.85);transition:filter .4s,transform .4s;border:2px solid rgba(214,163,55,.35);}
.fs-item:hover{filter:grayscale(0) brightness(1);transform:translateY(-6px) scale(1.08) rotate(-2deg);}

.food-banner{position:relative;min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;padding:60px 24px;}
.fb-photo{position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1512058564366-18510be2db19?q=80&w=1800&auto=format&fit=crop');background-size:cover;background-position:center;animation:kenburns 20s ease-in-out infinite alternate;}
.fb-scrim{position:absolute;inset:0;background:linear-gradient(160deg,rgba(13,4,32,.82),rgba(43,15,92,.78));}
.fb-content{position:relative;z-index:1;}
.fb-content .eye{font-weight:800;letter-spacing:3px;text-transform:uppercase;font-size:.8rem;margin-bottom:10px;}
.features{background:var(--green);padding:55px 24px;}
.feat-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:22px;}
.feat-card{text-align:center;color:white;padding:32px 20px;border-radius:20px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);transition:transform .4s cubic-bezier(.34,1.56,.64,1),background .3s,box-shadow .4s;}
.feat-card:hover{background:rgba(255,255,255,.16);transform:translateY(-10px) scale(1.03);box-shadow:0 16px 34px rgba(0,0,0,.25);}
.feat-card:hover .feat-icon svg{transform:scale(1.2) rotate(-6deg);}
.feat-icon svg{transition:transform .4s cubic-bezier(.34,1.56,.64,1);}
.feat-icon{margin-bottom:14px;color:var(--gold-light);display:flex;justify-content:center;}
.feat-card h3{font-size:1.03rem;font-weight:800;margin-bottom:8px;}
.feat-card p{font-size:.85rem;opacity:.78;line-height:1.6;}

.sec-hdr{text-align:center;margin-bottom:50px;}
.sec-hdr .eye{color:var(--green-mid);font-weight:800;font-size:.8rem;letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;}
.sec-hdr h2{font-family:'Fraunces',serif;font-size:clamp(1.9rem,5vw,3rem);color:var(--dark);font-weight:900;}
.sec-hdr h2 .acc{color:var(--green-mid);}
.gold-ln{width:78px;height:4px;background:linear-gradient(90deg,var(--gold),var(--green-light));margin:13px auto 0;border-radius:2px;}
.sec-hdr .sub{margin-top:12px;color:#666;font-size:.9rem;}

.bfast-sec{padding:80px 24px;background:var(--cream);}
.bfast-grid{max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:16px;}
.day-card{background:white;border-radius:18px;padding:22px 28px;display:flex;align-items:center;gap:20px;box-shadow:0 3px 18px rgba(0,0,0,.07);border-left:5px solid var(--green-light);transition:box-shadow .35s,transform .35s;}
.day-card:hover{box-shadow:0 12px 32px rgba(91,33,182,.18);transform:translateX(8px) scale(1.015);}
.day-num{min-width:52px;height:52px;background:var(--green);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:1rem;font-weight:900;flex-shrink:0;}
.day-info h3{font-family:'Fraunces',serif;font-size:1.08rem;color:var(--dark);margin-bottom:3px;}
.day-info p{color:#555;font-size:.87rem;}
.day-em{font-size:1.8rem;margin-left:auto;flex-shrink:0;}

.menu-sec{padding:80px 24px;}
.lbg{background:#f3edfc;}
.dbg{background:#fff;}
.week-grid{max-width:1080px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(235px,1fr));gap:20px;}
.week-card{background:white;border-radius:20px;box-shadow:0 3px 18px rgba(0,0,0,.07);overflow:hidden;transition:box-shadow .4s,transform .4s cubic-bezier(.34,1.56,.64,1);}
.week-card:hover{transform:translateY(-8px) scale(1.015);box-shadow:0 16px 34px rgba(91,33,182,.16);}
.week-card:hover{box-shadow:0 10px 32px rgba(0,0,0,.13);transform:translateY(-5px);}
.wk-head{background:var(--green);color:white;padding:14px 22px;font-family:'Fraunces',serif;font-size:1.08rem;font-weight:700;}
.week-card ul{list-style:none;padding:14px 22px 18px;}
.week-card ul li{padding:8px 0;border-bottom:1px solid #f2f2f2;font-size:.88rem;color:#444;display:flex;align-items:flex-start;gap:9px;}
.week-card ul li:last-child{border-bottom:none;}
.week-card ul li::before{content:'•';color:var(--gold);font-size:1rem;font-weight:900;flex-shrink:0;margin-top:-2px;}

.self-order-sec{padding:80px 24px;background:#f6f1fb;}
.menu-tabs{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:36px;}
.tab-btn{padding:10px 22px;border-radius:30px;border:2px solid var(--green-light);background:white;color:var(--green);font-weight:700;font-size:.88rem;cursor:pointer;transition:all .25s cubic-bezier(.34,1.56,.64,1);font-family:'Manrope',sans-serif;}
.tab-btn:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 8px 18px rgba(91,33,182,.2);}
.tab-btn.active,.tab-btn:hover{background:var(--green);color:white;border-color:var(--green);}
.menu-panel{display:none;max-width:1080px;margin:0 auto;}
.menu-panel.active{display:block;}
.items-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;}
.item-card{background:white;border-radius:18px;box-shadow:0 3px 18px rgba(0,0,0,.07);overflow:hidden;transition:transform .4s cubic-bezier(.34,1.56,.64,1),box-shadow .4s;border:1px solid #eef4ee;}
.item-card:hover{transform:translateY(-8px) scale(1.02);box-shadow:0 16px 36px rgba(91,33,182,.16);}
.item-top{background:linear-gradient(135deg,var(--green),var(--green-mid));padding:16px 20px;color:white;display:flex;align-items:center;gap:12px;}
.item-emoji{font-size:2rem;}
.item-name{font-family:'Fraunces',serif;font-size:1rem;font-weight:700;}
.item-body{padding:16px 20px;}
.price-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.price-tag{background:#f3edfc;border-radius:12px;padding:6px 14px;font-weight:800;color:var(--green);font-size:.9rem;transition:transform .25s,background .25s;}
.price-tag:hover{transform:scale(1.08);background:#e9dbfb;}
.price-label{font-size:.78rem;color:#888;font-weight:600;}
.single-price{color:var(--green);font-size:1.2rem;font-weight:900;font-family:'Fraunces',serif;margin-bottom:12px;}
.add-btn{width:100%;margin-top:8px;padding:10px;background:linear-gradient(135deg,var(--green),var(--green-mid));color:white;border:none;border-radius:12px;font-family:'Manrope',sans-serif;font-weight:700;font-size:.88rem;cursor:pointer;transition:transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s;}
.add-btn:hover{transform:scale(1.04);box-shadow:0 8px 20px rgba(91,33,182,.35);}
.add-btn:active{transform:scale(.97);}
.add-btn:hover{transform:translateY(-2px);}
.add-btn-gold{background:linear-gradient(135deg,#c9a84c,#e8c060)!important;color:#0f1f12!important;}

.cart-badge{position:fixed;bottom:100px;right:28px;z-index:9997;background:var(--gold);color:var(--dark);width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 6px 20px rgba(0,0,0,.25);cursor:pointer;transition:transform .3s cubic-bezier(.34,1.56,.64,1);}
.cart-badge:hover{transform:scale(1.12) rotate(-6deg);}
.cart-count{font-size:.7rem;font-weight:800;background:var(--red);color:white;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;position:absolute;top:-4px;right:-4px;}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:99999;align-items:center;justify-content:center;padding:20px;}
.modal-overlay.open{display:flex;}
.modal-box{background:white;border-radius:24px;width:100%;max-width:550px;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.modal-head{background:var(--green);color:white;padding:24px 28px;border-radius:24px 24px 0 0;display:flex;justify-content:space-between;align-items:center;}
.modal-head h3{font-family:'Fraunces',serif;font-size:1.4rem;}
.close-btn{background:rgba(255,255,255,.2);border:none;color:white;width:34px;height:34px;border-radius:50%;font-size:1.1rem;cursor:pointer;}
.modal-body{padding:24px 28px;}
.cart-empty{text-align:center;padding:40px 20px;color:#999;}
.cart-item{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid #f0f0f0;}
.ci-info{flex:1;}
.ci-name{font-weight:700;font-size:.93rem;}
.ci-sub{font-size:.8rem;color:#888;}
