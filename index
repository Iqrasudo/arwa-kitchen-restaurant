// Cart (kept client-side until checkout — this is the normal e-commerce
// pattern: browsing/building a cart doesn't need a database write, only
// the FINAL placed order does, and that now goes straight to Firestore.)
var cart=[];
window.addToCart=function(name,variant,price){
 var key=name+'|'+(variant||'');
 var ex=cart.find(function(i){return i.key===key;});
 if(ex){ex.qty++;}else{cart.push({key:key,name:name,variant:variant,price:price,qty:1});}
 updateCartBadge();showToast(' Added: '+name);
};
function updateCartBadge(){
 var total=cart.reduce(function(a,i){return a+i.qty;},0);
 document.getElementById('cartBadge').style.display=total>0?'flex':'none';
 document.getElementById('cartCount').textContent=total;
}
window.openCart=function(){renderCart();document.getElementById('cartModal').classList.add('open');};
window.closeCart=function(){document.getElementById('cartModal').classList.remove('open');};
function renderCart(){
 var body=document.getElementById('cartBody');
 if(!cart.length){body.innerHTML='<div class="cart-empty"><div style="font-size:3rem;margin-bottom:12px"></div><p>Cart is empty — add some items!</p></div>';return;}
 var html='';
 cart.forEach(function(item,idx){
 html+='<div class="cart-item"><div class="ci-info"><div class="ci-name">'+item.name+'</div>'+(item.variant?'<div class="ci-sub">'+item.variant+'</div>':'')+'</div>';
 html+='<div class="qty-ctrl"><button class="qty-btn" onclick="changeQty('+idx+',-1)">−</button><span class="qty-num">'+item.qty+'</span><button class="qty-btn" onclick="changeQty('+idx+',1)">+</button></div>';
 html+='<div class="ci-price">Rs. '+(item.price*item.qty).toLocaleString()+'</div><button class="remove-btn" onclick="removeItem('+idx+')"></button></div>';
 });
 var total=cart.reduce(function(a,i){return a+i.price*i.qty;},0);
 html+='<div class="cart-total"><span style="font-weight:800">Total:</span><span class="tot-amt">Rs. '+total.toLocaleString()+'</span></div>';
 html+='<button class="checkout-btn" onclick="goCheckout()"> Proceed to Checkout</button>';
 body.innerHTML=html;
}
window.changeQty=function(idx,d){cart[idx].qty+=d;if(cart[idx].qty<=0)cart.splice(idx,1);updateCartBadge();renderCart();};
window.removeItem=function(idx){cart.splice(idx,1);updateCartBadge();renderCart();};
function resetCheckoutUI(){
 var form=document.getElementById('coForm');
 var success=document.getElementById('coSuccess');

 if(form) form.style.display='block';
 if(success) success.style.display='none';

 var btn=document.querySelector('.place-btn');
 if(btn){
 btn.disabled=false;
 btn.textContent=' Confirm Order';
 }
}

window.goCheckout=function(){

 // ALWAYS use Firebase's real current session.
 // Do not rely on a manually maintained variable.
 const user = auth.currentUser;

 if(!user){
 window.pendingCheckout = true;
 openAuth('login');
 return;
 }

 if(!cart.length){
 showToast(' Your cart is empty.');
 return;
 }

 resetCheckoutUI();
 closeCart();

 var html='<h4>Order Summary</h4>';

 cart.forEach(function(i){
 html += '<div class="os-item">' +
 '<span>' +
 i.name +
 (i.variant ? ' ('+i.variant+')' : '') +
 (i.qty > 1 ? ' ×'+i.qty : '') +
 '</span>' +
 '<span>Rs. '+(i.price*i.qty).toLocaleString()+'</span>' +
 '</div>';
 });

 var total=cart.reduce(function(a,i){
 return a+i.price*i.qty;
 },0);

 html += '<div class="os-total">' +
 '<span>Total</span>' +
 '<span>Rs. '+total.toLocaleString()+'</span>' +
 '</div>';

 document.getElementById('oSummary').innerHTML=html;
 document.getElementById('coModal').classList.add('open');
};


window.placeOrder=async function(){

 // Get the REAL Firebase user every time an order is placed.
 const user = auth.currentUser;

 if(!user){
 window.pendingCheckout = true;
 openAuth('login');
 return;
 }

 var name=document.getElementById('coName').value.trim();
 var phone=document.getElementById('coPhone').value.trim();
 var addr=document.getElementById('coAddr').value.trim();

 if(!name){
 alert('Please enter your name.');
 return;
 }

 if(!phone){
 alert('Please enter your phone number.');
 return;
 }

 if(!addr){
 alert('Please enter your delivery address.');
 return;
 }

 if(!cart.length){
 alert('Your cart is empty.');
 return;
 }

 var btn=document.querySelector('.place-btn');
 var oldText=btn ? btn.textContent : ' Confirm Order';

 if(btn){
 btn.disabled=true;
 btn.textContent='Sending Order...';
 }

 var total=cart.reduce(function(a,i){
 return a+i.price*i.qty;
 },0);

 var items=cart.map(function(i){
 return i.name+
 (i.variant?' ('+i.variant+')':'')+
 (i.qty>1?' ×'+i.qty:'')+
 ' — Rs.'+(i.price*i.qty);
 }).join('\n');

 try{

 /*
 * IMPORTANT:
 * Use the Firebase user captured above.
 * This account remains logged in after the order.
 */
 await window.addOrder({
 type:'cart',
 uid:user.uid,
 email:user.email || '',
 name:name,
 phone:phone,
 address:addr,
 items:items,
 total:'Rs. '+total.toLocaleString(),
 note:document.getElementById('coNote').value
 });

 document.getElementById('coForm').style.display='none';
 document.getElementById('coSuccess').style.display='block';

 // Clear only checkout fields.
 // DO NOT logout the customer.
 document.getElementById('coName').value='';
 document.getElementById('coPhone').value='';
 document.getElementById('coAddr').value='';
 document.getElementById('coNote').value='';

 // Clear only the cart after successful order.
 cart=[];
 updateCartBadge();

 /*
 * DO NOT call:
 * signOut(auth)
 * customerLogout()
 * window.firebaseUser = null
 *
 * The customer stays logged in and can place another order.
 */

 showToast(' Order placed successfully!');

 }catch(err){

 console.error('Order submission failed:',err);

 alert(
 'Order could not be submitted.\\n\\n' +
 (err && err.code ? err.code : 'Firebase/Firestore error')
 );

 }finally{

 if(btn){
 btn.disabled=false;
 btn.textContent=oldText;
 }
 }
};



