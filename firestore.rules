rules_version = '2';

// Firestore Security Rules for Arwa Kitchen
// -------------------------------------------------
// HOW TO APPLY:
// Firebase Console → Build → Firestore Database → Rules tab
// → paste this content → Publish
//
// LOGIC:
// - Anyone (customers, not logged in) can CREATE a new order/subscription
//   — this is what lets the website submit orders without login.
// - Only an authenticated admin (someone who logged in through the
//   Admin Panel with email + password) can READ, UPDATE or DELETE orders.
//   This is what keeps customer data (names, phone numbers, addresses)
//   private from the public.
// -------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
